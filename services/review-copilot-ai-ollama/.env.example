# Local Ollama API. Docker Compose overrides this with host.docker.internal.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_TOKENS=8192

# Maximum generated tokens per response.
OLLAMA_MAX_OUTPUT_TOKENS=2000

# Keep persistent data outside the image in production.
DATA_DIR=./data

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://lh-review-copilot-20260727.geonnii.chatgpt.site

MAX_UPLOAD_MB=25
DEFAULT_TOP_K=4
MAX_TOP_K=8
